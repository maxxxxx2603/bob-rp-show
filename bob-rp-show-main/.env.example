# ── RP Showroom — Variables d'environnement ──────────────────────────────────

PORT=4000
SESSION_SECRET=change_moi_32_caracteres_minimum

# ── MOT DE PASSE ADMIN ──────────────────────────────────────────────────────
# Sur Railway : ajoute cette variable dans l'onglet Variables de ton service.
# Le site utilisera DIRECTEMENT ce mot de passe — pas de setup au premier lancement.
# Si cette variable est absente, le site te demandera de créer un mdp au 1er accès.
ADMIN_PASSWORD=ton_mot_de_passe_ici

# ── OPTIONNEL ────────────────────────────────────────────────────────────────
# Secret partagé avec les bots pour les logs/activité
LOG_SECRET=
